<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Settings" src="project://database/Assets/UI/Views/Settings.uxml?fileID=9197481963319205126&amp;guid=f54ae45c39b925246b2d8d6f574b23bf&amp;type=3#Settings" />
    <ui:Template name="Scene" src="project://database/Assets/UI/Views/Scene.uxml?fileID=9197481963319205126&amp;guid=335b879c4b992f24bbb0951447e39262&amp;type=3#Scene" />
    <ui:Template name="Atlas" src="project://database/Assets/UI/Views/Atlas.uxml?fileID=9197481963319205126&amp;guid=9c87ec2a39db64e41ac639d9d458023a&amp;type=3#Atlas" />
    <ui:Template name="ChannelMap" src="project://database/Assets/UI/Views/ChannelMap.uxml?fileID=9197481963319205126&amp;guid=eacbf3863aa53e247902b99462b2943f&amp;type=3#ChannelMap" />
    <ui:Template name="Inspector" src="project://database/Assets/UI/Views/ProbeInspector.uxml?fileID=9197481963319205126&amp;guid=e0575549e4e36cd40ac9d038669e3e54&amp;type=3#ProbeInspector" />
    <ui:Template name="ManipulatorInspector" src="project://database/Assets/UI/Views/ManipulatorInspector.uxml?fileID=9197481963319205126&amp;guid=548563d6332996b48876c7469ab9a17c&amp;type=3#ManipulatorInspector" />
    <ui:Template name="Automation" src="project://database/Assets/UI/Views/AutomationInspector.uxml?fileID=9197481963319205126&amp;guid=21db5dd8d01541a489f4ebd6415cd66a&amp;type=3#AutomationInspector" />
    <Style src="project://database/Assets/UI/Styles/MainStyles.uss?fileID=7433441132597879392&amp;guid=952e482a7ce9439785fff3fbcda74456&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/ProbeColors.uss?fileID=7433441132597879392&amp;guid=9abd22c2e53247999e8fd0a05c609d97&amp;type=3#ProbeColors" />
    <Unity.AppUI.UI.Panel data-source-type="UI.ViewModels.MainViewModel, Assembly-CSharp" picking-mode="Ignore" style="background-color: rgba(29, 29, 29, 0);">
        <Unity.AppUI.UI.SplitView show-expand-buttons="true" name="main-split-view" style="flex-grow: 1;">
            <Unity.AppUI.UI.Pane class="side-panel" style="width: 27%;">
                <ui:VisualElement style="flex-direction: row;">
                    <Unity.AppUI.UI.MenuTrigger>
                        <Unity.AppUI.UI.ActionButton label="File" icon="file" />
                        <Unity.AppUI.UI.Menu>
                            <Unity.AppUI.UI.MenuItem label="Save" />
                            <Unity.AppUI.UI.MenuItem label="Load" />
                        </Unity.AppUI.UI.Menu>
                    </Unity.AppUI.UI.MenuTrigger>
                    <Unity.AppUI.UI.Spacer />
                    <Unity.AppUI.UI.DialogTrigger>
                        <Unity.AppUI.UI.ActionButton label="Settings" icon="gear" />
                        <Unity.AppUI.UI.Dialog title="Settings" size="L" dismissable="true">
                            <ui:Instance template="Settings" name="settings-view" style="flex-grow: 1; height: 500px;" />
                        </Unity.AppUI.UI.Dialog>
                    </Unity.AppUI.UI.DialogTrigger>
                    <Unity.AppUI.UI.Spacer />
                    <Unity.AppUI.UI.Toggle label="Automation" name="automation-toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="IsAutomationModeActive" binding-mode="TwoWay" />
                        </Bindings>
                    </Unity.AppUI.UI.Toggle>
                    <Unity.AppUI.UI.Spacer spacing="Expand" />
                    <Unity.AppUI.UI.Button leading-icon="minus" name="left-side-panel__collapse-button" />
                </ui:VisualElement>
                <Unity.AppUI.UI.Tabs name="left-side-panel__tabs" value="0">
                    <Unity.AppUI.UI.TabItem label="Scene" />
                    <Unity.AppUI.UI.TabItem label="Atlas" />
                    <Unity.AppUI.UI.TabItem label="Channels" />
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="LeftSidePanelTabIndex" binding-mode="TwoWay" />
                    </Bindings>
                </Unity.AppUI.UI.Tabs>
                <Unity.AppUI.UI.SwipeView swipeable="false" value="0" snap-animation-speed="0.2" style="flex-grow: 1; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                    <Unity.AppUI.UI.SwipeViewItem>
                        <ui:Instance template="Scene" name="scene-view" style="flex-grow: 1; width: 100%;" />
                    </Unity.AppUI.UI.SwipeViewItem>
                    <Unity.AppUI.UI.SwipeViewItem>
                        <ui:Instance template="Atlas" name="atlas-view" style="flex-grow: 1; width: 100%;" />
                    </Unity.AppUI.UI.SwipeViewItem>
                    <Unity.AppUI.UI.SwipeViewItem>
                      <ui:Instance template="ChannelMap" name="channel-map-view" style="flex-grow: 1; width: 100%;" />
                     </Unity.AppUI.UI.SwipeViewItem>
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="LeftSidePanelTabIndex" binding-mode="ToTarget" />
                    </Bindings>
                </Unity.AppUI.UI.SwipeView>
            </Unity.AppUI.UI.Pane>
            <Unity.AppUI.UI.Pane stretch-factor="1" style="align-items: flex-end;">
                <ui:VisualElement style="flex-grow: 0; background-image: url(&quot;project://database/Packages/vbl.urchin/Assets/RenderTextures/ControlsTexture.renderTexture?fileID=8400000&amp;guid=4a0918ef4c8b3584f8a2ac5327fd2cff&amp;type=2#ControlsTexture&quot;); width: 100px; height: 100px; align-items: stretch; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;" />
            </Unity.AppUI.UI.Pane>
            <Unity.AppUI.UI.Pane class="side-panel" style="width: 27%;">
                <ui:VisualElement style="flex-direction: row;">
                    <Unity.AppUI.UI.Button leading-icon="minus" name="right-side-panel__collapse-button" />
                    <Unity.AppUI.UI.Spacer />
                    <Unity.AppUI.UI.Heading text="Inspector">
                        <Bindings>
                            <ui:DataBinding property="style.display" data-source-path="IsRightSidePanelOpen" binding-mode="ToTarget" />
                        </Bindings>
                    </Unity.AppUI.UI.Heading>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                    <Unity.AppUI.UI.Heading text="Select an item to inspect..." size="S" style="flex-grow: 1; -unity-text-align: middle-center;" />
                    <Bindings>
                        <ui:DataBinding property="style.display" data-source-path="InspectorDisplayType" binding-mode="ToTarget" source-to-ui-converters="InspectorDisplayTypeToNothingSelectedVisibility" />
                    </Bindings>
                </ui:VisualElement>
                <ui:ScrollView>
                    <ui:VisualElement>
                        <ui:Instance template="Inspector" name="probe-inspector-view" />
                        <Bindings>
                            <ui:DataBinding property="enabledSelf" data-source-path="IsAutomationModeActive" binding-mode="ToTarget" source-to-ui-converters="IsAutomationActiveToProbeInspectorEnabled" />
                            <ui:DataBinding property="style.display" data-source-path="InspectorDisplayType" binding-mode="ToTarget" source-to-ui-converters="InspectorDisplayTypeToProbeInspectorVisibility" />
                        </Bindings>
                    </ui:VisualElement>
                    <ui:VisualElement>
                        <ui:Instance template="ManipulatorInspector" name="manipulator-inspector-view" />
                        <Bindings>
                            <ui:DataBinding property="style.display" data-source-path="InspectorDisplayType" binding-mode="ToTarget" source-to-ui-converters="InspectorDisplayTypeToManipulatorInspectorVisibility" />
                        </Bindings>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Instance template="Automation" name="automation-inspector-view" style="flex-grow: 1;" />
                        <Bindings>
                            <ui:DataBinding property="style.display" data-source-path="InspectorDisplayType" binding-mode="ToTarget" source-to-ui-converters="InspectorDisplayTypeToAutomationInspectorVisibility" />
                        </Bindings>
                    </ui:VisualElement>
                    <Bindings>
                        <ui:DataBinding property="style.display" data-source-path="InspectorDisplayType" binding-mode="ToTarget" source-to-ui-converters="InspectorDisplayTypeToInspectorScrollViewVisibility" />
                    </Bindings>
                </ui:ScrollView>
            </Unity.AppUI.UI.Pane>
        </Unity.AppUI.UI.SplitView>
    </Unity.AppUI.UI.Panel>
</ui:UXML>
