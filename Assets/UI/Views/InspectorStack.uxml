<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/InspectorStyle.uss?fileID=7433441132597879392&amp;guid=a2355dc3cb713b34c80b9934307f1c56&amp;type=3#InspectorStyle" />
    <Style src="project://database/Assets/UI/Styles/GeneralStyles.uss?fileID=7433441132597879392&amp;guid=a584e5b7cc579974fb178eba0841b4cb&amp;type=3#GeneralStyles" />
    <engine:ScrollView style="flex-grow: 1;">
        <engine:VisualElement class="inspectorBox inspector-panel">
            <Unity.AppUI.UI.Heading text="Position &amp; Orientation" size="S" />
            <Unity.AppUI.UI.Vector4Field tooltip="Probe position" />
            <Unity.AppUI.UI.Divider />
            <Unity.AppUI.UI.Vector3Field tooltip="Probe orientation" />
        </engine:VisualElement>
        <engine:VisualElement class="inspectorBox inspector-panel" style="flex-direction: column; flex-wrap: nowrap;">
            <Unity.AppUI.UI.Heading text="Probe Controls" size="S" />
            <Unity.AppUI.UI.ActionGroup compact="true" direction="Vertical">
                <Unity.AppUI.UI.ActionButton label="Lock" icon="lock" />
                <Unity.AppUI.UI.ActionButton label="Duplicate" icon="copy" />
                <Unity.AppUI.UI.ActionButton label="Move to Reference Coordinate" icon="waypoint-home" />
                <Unity.AppUI.UI.ActionButton label="Move to Dura" icon="align-bottom-simple" />
            </Unity.AppUI.UI.ActionGroup>
        </engine:VisualElement>
        <engine:VisualElement class="inspectorBox inspector-panel">
            <Unity.AppUI.UI.Heading text="Probe Color" size="S" />
            <engine:VisualElement name="ProbeColorPicker" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                <engine:RadioButton name="1F77B4" />
                <engine:RadioButton name="AEC7E8" />
                <engine:RadioButton name="FF7F0E" />
                <engine:RadioButton name="FFBB78" />
                <engine:RadioButton name="2CA02C" />
                <engine:RadioButton name="98DF8A" />
                <engine:RadioButton name="D62728" />
                <engine:RadioButton name="FF9896" />
                <engine:RadioButton name="9467BD" />
                <engine:RadioButton name="C5B0D5" />
                <engine:RadioButton name="8C564B" />
                <engine:RadioButton name="C49C94" />
                <engine:RadioButton name="E377C2" />
                <engine:RadioButton name="F7B6D2" />
                <engine:RadioButton name="7F7F7F" />
                <engine:RadioButton name="C7C7C7" />
                <engine:RadioButton name="DBDB8D" />
                <engine:RadioButton name="17BECF" />
                <engine:RadioButton name="9EDAE5" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:ScrollView>
</engine:UXML>
