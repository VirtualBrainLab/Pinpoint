<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/GeneralStyles.uss?fileID=7433441132597879392&amp;guid=a584e5b7cc579974fb178eba0841b4cb&amp;type=3#GeneralStyles" />
    <ui:VisualElement data-source-type="UI.ViewModels.EphysLinkViewModel, Assembly-CSharp" class="inspector-panel" style="flex-grow: 1;">
        <ui:VisualElement>
            <Unity.AppUI.UI.Heading text="Select Platform" size="S" />
            <Unity.AppUI.UI.Dropdown default-message="Select a platform..." name="ephys-link__platform-type-dropdown" />
            <Unity.AppUI.UI.Divider />
        </ui:VisualElement>
        <ui:VisualElement>
            <Unity.AppUI.UI.Heading text="HTTP Server Port" size="S" />
            <Unity.AppUI.UI.IntField low-value="0" high-value="49151" value="8080" tooltip="Enter the server&apos;s TCP/IP port" />
            <Unity.AppUI.UI.Divider />
            <Bindings>
                <ui:DataBinding property="style.display" data-source-path="SelectedPlatformType" binding-mode="ToTarget" source-to-ui-converters="PlatformTypeToPathfinderMPMHTTPServerConnectionVisibility" />
            </Bindings>
        </ui:VisualElement>
        <ui:VisualElement>
            <Unity.AppUI.UI.Heading text="Connection Details" size="S" />
            <Unity.AppUI.UI.TextField placeholder="Server IP Address..." tooltip="Enter the server&apos;s IP address" value="localhost" />
            <Unity.AppUI.UI.IntField low-value="0" high-value="49151" value="3000" tooltip="Enter the server&apos;s TCP/IP port" />
            <Unity.AppUI.UI.Divider />
            <Bindings>
                <ui:DataBinding property="style.display" data-source-path="SelectedPlatformType" binding-mode="ToTarget" source-to-ui-converters="PlatformTypeToCustomServerConnectionVisibility" />
            </Bindings>
        </ui:VisualElement>
        <Unity.AppUI.UI.Button title="Connect" name="ephys-link__connect-button" />
        <Unity.AppUI.UI.Button title="Disconnect" name="ephys-link__disconnect-button" />
    </ui:VisualElement>
</ui:UXML>
